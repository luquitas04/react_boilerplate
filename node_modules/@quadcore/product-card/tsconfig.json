{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "declaration": true,
    "declarationDir": "./dist/types",
    "outDir": "./dist",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "paths": {
      "@quadcore/core": ["../core/src/index.ts"]
    }
  },
  "include": ["src", "index.ts"]
}
